{
  "name": "kemo-design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test scripts/park-ui/",
    "park-ui": "node scripts/park-ui/sync.mjs",
    "clean": "find . -type d \\( -name node_modules -o -name styled-system -o -name dist -o -name .next -o -name playwright-report -o -name test-results \\) -prune -exec rm -rf {} +",
    "dev": "pnpm --filter @kemo/ui lib && concurrently -k -n ui,preview -c blue,green \"pnpm --filter @kemo/ui watch\" \"pnpm --filter @kemo/preview dev\"",
    "build": "pnpm --filter @kemo/ui lib && pnpm --filter @kemo/preview build",
    "test:e2e": "pnpm --filter @kemo/preview test:e2e",
    "e2e:install": "pnpm --filter @kemo/preview exec playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pandacss/eslint-plugin": "^2.5.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
